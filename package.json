{
  "name": "dsh-codex-review",
  "version": "1.0.0",
  "private": true,
  "description": "DSH Host 插件：给智能体一个直接调用 codex review 的工具",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "selftest.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
